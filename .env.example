# Required for the main coding model
OPENAI_API_KEY=your_openai_api_key

# Optional. If absent, Dertek uses the built-in heuristic router.
TYPESAFE_API_KEY=your_typesafe_api_key

# Optional Dertek settings
DERTEK_MODEL=gpt-5.5
DERTEK_PROVIDER=openai
DERTEK_ROUTER_HIGH_CONFIDENCE=0.90
DERTEK_ROUTER_MEDIUM_CONFIDENCE=0.65
DERTEK_MAX_STEPS=12
DERTEK_SHELL_TIMEOUT_SECONDS=120
DERTEK_APPROVAL_MODE=on-request
